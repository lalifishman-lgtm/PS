-- สร้างแท็บต่างๆ
local Tabs = {
    Visuals = Window:Tab({ Title = "Roles & ESP", Icon = "eye" }),
    Combat  = Window:Tab({ Title = "Combat & Auto", Icon = "crosshair" }),
    Misc    = Window:Tab({ Title = "Teleports & Gun", Icon = "map-pin" })
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- ฟังก์ชันตรวจสอบบทบาทและตำแหน่งปืนตก (Gun Dropped)
local function GetRoles()
    local murderer, sheriff, droppedGun = nil, nil, nil
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife") then
                murderer = player
            elseif player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun") then
                sheriff = player
            end
        end
    end

    -- คหาปืนที่ตกอยู่บนแมพ
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name == "GunDrop" and obj:FindFirstChild("Handle") then
            droppedGun = obj
        end
    end

    return murderer, sheriff, droppedGun
end

--------------------------------------------------------------------------------
-- 1. TAB VISUALS: ดูบทบาท (ฆาตกร:แดง, นายอำเภอ:ฟ้า, ผู้บริสุทธิ์:เขียว, ปืน:เหลือง)
--------------------------------------------------------------------------------
Tabs.Visuals:Section({ Title = "Role & Item ESP System" })

local roleEspEnabled = false
local highlights = {}

local function ClearESP()
    for _, hl in pairs(highlights) do
        if hl then hl:Destroy() end
    end
    highlights = {}
end

Tabs.Visuals:Toggle({
    Title = "Role & Gun ESP (ฆาตกร:แดง | นายอำเภอ:ฟ้า | ประชาชน:เขียว | ปืน:เหลือง)",
    Default = false,
    Callback = function(state)
        roleEspEnabled = state
        if not state then ClearESP() end
    end
})

-- ลูปอัปเดต ESP สีตามบทบาทและปืน
task.spawn(function()
    while task.wait(1) do
        if roleEspEnabled then
            ClearESP()
            local murderer, sheriff, droppedGun = GetRoles()

            -- ESP ผู้เล่น
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local hl = Instance.new("Highlight")
                    hl.Parent = player.Character
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0

                    if player == murderer then
                        hl.FillColor = Color3.fromRGB(255, 0, 0) -- ฆาตกร (สีแดง)
                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                    elseif player == sheriff then
                        hl.FillColor = Color3.fromRGB(0, 150, 255) -- นายอำเภอ (สีฟ้า)
                        hl.OutlineColor = Color3.fromRGB(0, 150, 255)
                    else
                        hl.FillColor = Color3.fromRGB(0, 255, 0) -- ผู้บริสุทธิ์ (สีเขียว)
                        hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                    end
                    table.insert(highlights, hl)
                end
            end

            -- ESP ปืนที่ตกอยู่ (สีเหลือง)
            if droppedGun and droppedGun:FindFirstChild("Handle") then
                local gunHl = Instance.new("Highlight")
                gunHl.Parent = droppedGun
                gunHl.FillColor = Color3.fromRGB(255, 255, 0) -- สีเหลือง
                gunHl.OutlineColor = Color3.fromRGB(255, 255, 0)
                gunHl.FillTransparency = 0.2
                table.insert(highlights, gunHl)
            end
        end
    end
end)


