-- 3. TAB MISC: ออโต้เก็บปืนแล้ววาร์ปกลับตำแหน่งเดิม
--------------------------------------------------------------------------------
Tabs.Misc:Section({ Title = "Gun Collector & Teleports" })

local autoGrabGun = false
Tabs.Misc:Toggle({
    Title = "ออโต้เก็บปืนแล้ววาร์ปกลับตำแหน่งเดิม",
    Default = false,
    Callback = function(state)
        autoGrabGun = state
    end
})

task.spawn(function()
    while task.wait(0.5) do
        if autoGrabGun then
            local _, _, droppedGun = GetRoles()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if droppedGun and droppedGun:FindFirstChild("Handle") and hrp then
                -- บันทึกตำแหน่งเดิมก่อนวาร์ป
                local originalPos = hrp.CFrame
                
                -- วาร์ปไปหาปืนที่ตกอยู่
                hrp.CFrame = droppedGun.Handle.CFrame
                task.wait(0.3)
                
                -- วาร์ปกลับตำแหน่งเดิมทันที
                hrp.CFrame = originalPos
            end
        end
    end
end)

